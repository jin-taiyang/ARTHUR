"""
Arthur - Mini AI (Embeddings + Retrieval + OpenAI Responses)
- Requires: set env var OPENAI_API_KEY
- Install: pip install -r requirements.txt
"""

import os
import json
import math
from typing import List, Dict, Any
from tqdm import tqdm

import wikipediaapi
import numpy as np
from dotenv import load_dotenv

# OpenAI official modern client
# Install via pip install openai
from openai import OpenAI

load_dotenv()  # loads .env if exists

# -------------------------
# Configuration
# -------------------------
OPENAI_API_KEY = os.environ.get("OPENAI_API_KEY")
if not OPENAI_API_KEY:
    raise RuntimeError("Set OPENAI_API_KEY in environment (or in a .env file).")

# Initialize OpenAI client (reads API key from env automatically, but set here for clarity)
client = OpenAI()

# Model choices -- you can change per your access
EMBEDDING_MODEL = "text-embedding-3-large"   # embeddings model
# For generation you can choose a Responses-capable model you have access to, e.g. "gpt-5" or "gpt-4o"
GENERATION_MODEL = "gpt-4o"  # change if you prefer "gpt-5" or other

STORE_FILE = "arthur_store.json"  # local DB of {page, chunks, embeddings}
CHUNK_CHARS = 1000   # size for chunking wikipedia text (adjust)

# -------------------------
# Utilities
# -------------------------
def chunk_text(text: str, max_chars: int = CHUNK_CHARS) -> List[str]:
    """Simple chunker: splits by paragraphs then builds chunks up to max_chars."""
    paragraphs = [p.strip() for p in text.split("\n") if p.strip()]
    chunks = []
    cur = ""
    for p in paragraphs:
        if len(cur) + len(p) + 1 <= max_chars:
            cur += ("\n" if cur else "") + p
        else:
            if cur:
                chunks.append(cur)
            # if single paragraph longer than max, break it
            if len(p) > max_chars:
                for i in range(0, len(p), max_chars):
                    chunks.append(p[i:i+max_chars])
                cur = ""
            else:
                cur = p
    if cur:
        chunks.append(cur)
    return chunks

def cosine_similarity(a: np.ndarray, b: np.ndarray) -> float:
    if np.linalg.norm(a) == 0 or np.linalg.norm(b) == 0:
        return 0.0
    return float(np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b)))

# -------------------------
# Wikipedia ingestion
# -------------------------
def fetch_wikipedia_page(title: str) -> str:
    wiki = wikipediaapi.Wikipedia("en")
    page = wiki.page(title)
    if not page.exists():
        raise ValueError(f"Wikipedia page not found: {title}")
    return page.text

def embed_texts(texts: List[str]) -> List[List[float]]:
    """Call OpenAI embeddings API for a list of texts. Returns list of vectors."""
    # The modern client: client.embeddings.create(...)
    resp = client.embeddings.create(
        model=EMBEDDING_MODEL,
        input=texts
    )
    # response.data is a list of embeddings objects
    return [item.embedding for item in resp.data]

def add_page_to_store(title: str):
    """Fetch page, chunk it, embed chunks, and save to local store (STORE_FILE)."""
    print(f"[+] Fetching Wikipedia page: {title}")
    text = fetch_wikipedia_page(title)
    chunks = chunk_text(text)
    if not chunks:
        print("[!] No text chunks found.")
        return

    print(f"[+] Creating embeddings for {len(chunks)} chunks...")
    embeddings = embed_texts(chunks)

    # Load or init store
    if os.path.exists(STORE_FILE):
        with open(STORE_FILE, "r", encoding="utf-8") as f:
            store = json.load(f)
    else:
        store = {"items": []}

    for chunk, emb in zip(chunks, embeddings):
        store["items"].append({
            "source": title,
            "text": chunk,
            "embedding": emb
        })

    with open(STORE_FILE, "w", encoding="utf-8") as f:
        json.dump(store, f, ensure_ascii=False, indent=2)
    print(f"[+] Saved {len(chunks)} chunks to {STORE_FILE}.")

# -------------------------
# Simple retrieval
# -------------------------
def load_store() -> Dict[str, Any]:
    if not os.path.exists(STORE_FILE):
        return {"items": []}
    with open(STORE_FILE, "r", encoding="utf-8") as f:
        return json.load(f)

def retrieve_relevant_chunks(query: str, top_k: int = 4):
    store = load_store()
    texts = [item["text"] for item in store["items"]]
    embs = [np.array(item["embedding"], dtype=float) for item in store["items"]]
    if not embs:
        return []

    q_emb = np.array(client.embeddings.create(model=EMBEDDING_MODEL, input=[query]).data[0].embedding, dtype=float)

    # compute similarities
    sims = [cosine_similarity(q_emb, e) for e in embs]
    ranked_idx = sorted(range(len(sims)), key=lambda i: sims[i], reverse=True)[:top_k]
    return [ {"text": store["items"][i]["text"], "source": store["items"][i]["source"], "score": sims[i]} for i in ranked_idx]

# -------------------------
# Ask the model (Responses API)
# -------------------------
def ask_arthur(query: str, top_k: int = 4) -> str:
    # retrieve context
    hits = retrieve_relevant_chunks(query, top_k=top_k)
    context_parts = []
    for i, h in enumerate(hits, start=1):
        context_parts.append(f"[{i}] Source: {h['source']}\n{h['text'][:1500]}")  # trim for safety

    context_text = "\n\n---\n\n".join(context_parts) if context_parts else "No context found."

    system_instruction = (
        "You are Arthur, a helpful historical assistant. Use the provided context (if relevant) "
        "to answer precisely. If the context does not contain an answer, answer using general historical knowledge, "
        "and be explicit about uncertainty. Keep answers concise and cite the context chunk numbers if used."
    )

    user_prompt = f"Context:\n{context_text}\n\nUser question: {query}\n\nAnswer:"
    # Call Responses API
    response = client.responses.create(
        model=GENERATION_MODEL,
        input=[
            {"role": "system", "content": system_instruction},
            {"role": "user", "content": user_prompt}
        ],
        # you may set max_output_tokens etc.
    )

    # The Responses API returns items in response.output
    # Use helper properties if present; we fallback to joining text items
    # Newer SDKs may provide response.output_text
    try:
        # Preferred: response.output_text
        out_text = getattr(response, "output_text", None)
        if out_text:
            return out_text.strip()
    except Exception:
        pass

    # Fallback parsing:
    output_items = response.output if hasattr(response, "output") else response.get("output", [])
    parts = []
    for it in output_items:
        if isinstance(it, dict) and "content" in it:
            # structured item
            c = it["content"]
            if isinstance(c, list):
                for sub in c:
                    if isinstance(sub, dict) and "text" in sub:
                        parts.append(sub["text"])
                    elif isinstance(sub, str):
                        parts.append(sub)
            elif isinstance(c, str):
                parts.append(c)
        elif isinstance(it, dict) and "text" in it:
            parts.append(it["text"])
        elif isinstance(it, str):
            parts.append(it)
    return "\n".join(parts).strip() or "(no text in response)"

# -------------------------
# CLI / Example usage
# -------------------------
def interactive_loop():
    print("Arthur - mini AI (embeddings + retrieval + OpenAI Responses)")
    print("Commands:")
    print("  ingest <Wikipedia page title>   - fetch & store page chunks")
    print("  ask <your question>             - ask Arthur (uses stored pages)")
    print("  exit                            - quit")

    while True:
        raw = input("\n> ").strip()
        if not raw:
            continue
        if raw.lower() in ("exit", "quit"):
            break
        if raw.startswith("ingest "):
            title = raw[len("ingest "):].strip()
            try:
                add_page_to_store(title)
            except Exception as e:
                print("Error ingesting:", e)
        elif raw.startswith("ask "):
            q = raw[len("ask "):].strip()
            try:
                ans = ask_arthur(q, top_k=4)
                print("\nArthur:", ans)
            except Exception as e:
                print("Error asking Arthur:", e)
        else:
            print("Unknown command. Use 'ingest <title>' or 'ask <question>'.")

if __name__ == "__main__":
    interactive_loop()
